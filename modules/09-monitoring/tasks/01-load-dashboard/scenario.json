{
  "runs": [
    {
      "concurrency": 1,
      "requests": 200,
      "seconds": 10,
      "status_counts": {
        "200": 190,
        "503": 10
      },
      "p95_seconds": 0.08
    },
    {
      "concurrency": 4,
      "requests": 200,
      "seconds": 4,
      "status_counts": {
        "200": 200
      },
      "p95_seconds": 0.1
    }
  ],
  "target": "api:8000",
  "datasource": "http://prometheus:9090",
  "route": "/predict",
  "panels": [
    "rps",
    "error_ratio",
    "latency_p95"
  ],
  "scrape_up": 1
}
